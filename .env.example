# Chronicle — environment variables
#
# Copy this file to .env.local and fill in actual values.
# .env.local is gitignored. NEVER commit real keys.
#
# cp .env.example .env.local
# then edit .env.local with the keys below.

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — Anthropic Claude
# Sonnet 4.6 for medical event extraction (with Citations API + native PDF input)
# Also used as fallback for the patient-explainer if Gemini fights at H7 (per Q26 → Haiku 4.5)
# Get from: https://console.anthropic.com/settings/keys
# ─────────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED for "find related events" (Tier 1 feature, cuttable per Q23 cut order #2)
# Voyage voyage-3 embeddings, called from lib/voyage.ts
# ~$0.0005 per full eval run — well under any rate-limit ceiling
# Get from: https://dash.voyageai.com/
# ─────────────────────────────────────────────────────────────────────────────
VOYAGE_API_KEY=pa-REPLACE_ME

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — fallback for Voyage if it 401s or 429s
# OpenAI text-embedding-3-small. Same shape, slightly different pricing.
# lib/voyage.ts auto-falls-back if this key is present.
# Get from: https://platform.openai.com/api-keys
# ─────────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-REPLACE_ME

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED for "What does this mean?" patient-explainer (Tier 1, cuttable per Q23 cut order #5)
# Gemini Flash via @google/generative-ai SDK
# If you skip this, lib/gemini.ts falls back to Haiku 4.5 via ANTHROPIC_API_KEY (per Q26)
# Get from: https://aistudio.google.com/apikey
# ─────────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=AIzaSy-REPLACE_ME
