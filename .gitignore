# Environment variables — sensitive, never commit
.env.local
.env*.local
.env

# Dependencies (created at H0 Block 6 by create-next-app)
node_modules/
/.pnp
.pnp.*

# Next.js build output (created when dev server runs)
.next/
out/
*.tsbuildinfo
next-env.d.ts

# macOS
.DS_Store

# IDE
.vscode/
.idea/
*.swp

# Claude Code per-machine config (settings.local.json etc)
.claude/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Playwright MCP session output (screenshots + traces written next to the repo
# root during browser-driven review passes; *.log alone doesn't cover the .png)
.playwright-mcp/

# Held-out audit trail — keep ground_truth.json + .gt_hash.lock + prompt_hash.txt tracked,
# but eval run outputs change every run and shouldn't pollute history
held_out/case3/eval_runs/

# Claude API response cache for cached Cases 1+2 demos (regenerated by scripts/extract-case.ts)
data/cases/*/events.json.bak
